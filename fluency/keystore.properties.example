# Copy to keystore.properties (same folder) and fill in. keystore.properties is git-ignored.
# With it, release AND debug builds are signed with your release key, so "Run" in Android Studio
# updates the installed app without losing the downloaded models.
storeFile=/path/to/fluency-release.jks
storePassword=CHANGE_ME
keyAlias=fluency
keyPassword=CHANGE_ME
