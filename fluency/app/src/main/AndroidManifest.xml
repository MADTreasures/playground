<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used to download models (Hugging Face). Translation itself never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Glasses (G2 Watch): the connection runs as a foreground service, with the phone's microphone if allowed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Required by Android 14+ for the connectedDevice type; Fluency does not change any network itself. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- G2 Handy (phone half of the G2 Watch app): the only app the glasses service lets in -->
    <queries>
        <package android:name="ch.madtreasures.g2watch" />
    </queries>

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".FluencyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fluency"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="37">

        <!-- Adreno GPU (llama.cpp OpenCL backend, optional): vendor library must be declared. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- FastRPC: connection to the Hexagon NPU (llama.cpp's Hexagon backend) -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".models.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The app on the G2 glasses, by way of G2 Handy; it checks the caller (package and certificate). -->
        <service
            android:name=".glasses.GlassesService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice|microphone"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="ch.madtreasures.g2watch.action.LINK" />
            </intent-filter>
        </service>
    </application>
</manifest>
